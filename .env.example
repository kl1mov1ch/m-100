# Copy this file to .local/account.env. Never commit the completed private file.
PROJECT_NAME=M-100
STORAGE_MODE=google
TIMEZONE=Europe/Moscow
ALLOWED_USER_IDS=
ADMIN_USER_IDS=

# Google Sheets: native spreadsheet ID and exact tab name.
GOOGLE_SPREADSHEET_ID=
GOOGLE_SHEET_NAME=Лист1
GOOGLE_SERVICE_ACCOUNT_FILE=.local/secrets/google-service-account.json

# Optional AI: manual input works without this key.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_MAX_OUTPUT_TOKENS=2048
STT_MODEL=whisper-large-v3

# Optional Telegram mode. A token must have only one active polling process.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
MINIAPP_URL=

# Optional CRM; can also be configured in the administrator interface.
BITRIX_WEBHOOK_URL=
BITRIX_CATEGORY_ID=0
BITRIX_PORTAL_HOST=
